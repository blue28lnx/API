# --- Entorno ---
NODE_ENV=development
PORT=3000

# --- Base de datos (PostgreSQL) ---
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shortcuts_trainer?schema=public"

# --- JWT ---
# Mínimo 32 caracteres. Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-strong-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-another-strong-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- CORS ---
# Lista separada por comas. "*" habilita todos (no recomendado en prod).
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# --- Bcrypt ---
BCRYPT_COST=12

# --- Throttler (rate limit) ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL=60
AUTH_THROTTLE_LIMIT=10
